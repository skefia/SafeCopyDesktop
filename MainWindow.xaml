<Window x:Class="SafeCopy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeCopy" Height="820" Width="1220" MinHeight="720" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0E1627" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="26,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12" Background="#0C4A6E" Margin="0,0,14,0">
                    <Grid>
                        <Path Data="M10,3 L18,6 V11 C18,16 14.8,20.4 10,22 C5.2,20.4 2,16 2,11 V6 Z M6,10 L9,13 L14.5,7.5" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="11"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SafeCopy" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Verified migration and storage management" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#102A22" BorderBrush="#1D4D3B" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="v4.7.2 Desktop" Foreground="#86EFAC" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="18,14,18,0">
            <TabItem Header="Migration">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="8,14,8,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.08*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="0.92*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Migration" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Choose the exact source and destination directories." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,16"/>

                                    <TextBlock Text="SOURCE DIRECTORY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="SourceBox" MinHeight="38" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseSource_Click"/>
                                    </Grid>

                                    <TextBlock Text="DESTINATION DIRECTORY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="DestinationBox" MinHeight="38" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseDestination_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Operation" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Choose how SafeCopy should process this pair." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,14"/>
                                    <WrapPanel>
                                        <RadioButton x:Name="CopyMode" GroupName="Mode" Content="Copy + Verify" IsChecked="True" Style="{StaticResource ModeRadio}" Checked="Mode_Checked"/>
                                        <RadioButton x:Name="VerifyMode" GroupName="Mode" Content="Verify only" Style="{StaticResource ModeRadio}" Checked="Mode_Checked"/>
                                        <RadioButton x:Name="RetryMode" GroupName="Mode" Content="Retry failed" Style="{StaticResource ModeRadio}" Checked="Mode_Checked"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="ModeHint" Text="Copies/updates source paths, verifies contents, then runs a read-only final audit." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Performance" FontSize="16" FontWeight="SemiBold"/>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Copy threads" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <ComboBox x:Name="ThreadsBox" SelectedIndex="1" Margin="0,6,0,0" Height="36" Background="#0D1524" Foreground="White" BorderBrush="{StaticResource BorderBrush}">
                                                <ComboBoxItem Content="4"/><ComboBoxItem Content="8"/><ComboBoxItem Content="16"/><ComboBoxItem Content="32"/><ComboBoxItem Content="64"/>
                                            </ComboBox>
                                            <TextBlock Text="8 is a good HDD starting point." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Verification threads" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <ComboBox x:Name="VerifyThreadsBox" SelectedIndex="0" Margin="0,6,0,0" Height="36" Background="#0D1524" Foreground="White" BorderBrush="{StaticResource BorderBrush}">
                                                <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="4"/>
                                            </ComboBox>
                                            <TextBlock Text="1 is safest/faster for spinning HDDs." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Copy I/O speed" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <ComboBox x:Name="IoProfileBox" SelectedIndex="0" Margin="0,6,0,0" Height="36" Background="#0D1524" Foreground="White" BorderBrush="{StaticResource BorderBrush}" SelectionChanged="IoProfile_SelectionChanged">
                                                <ComboBoxItem Content="Maximum (unlimited)" Tag="Maximum"/>
                                                <ComboBoxItem Content="Balanced (100 MiB/s)" Tag="Balanced"/>
                                                <ComboBoxItem Content="Low impact (25 MiB/s)" Tag="LowImpact"/>
                                                <ComboBoxItem Content="Custom" Tag="Custom"/>
                                            </ComboBox>
                                            <TextBlock Text="Uses Robocopy native copy-phase throttling." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Custom limit (MiB/s)" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <TextBox x:Name="CustomIoRateBox" Text="50" IsEnabled="False" TextChanged="CustomIoRate_TextChanged" Margin="0,6,0,0" Height="36" VerticalContentAlignment="Center"/>
                                            <TextBlock Text="Applies only when Custom is selected." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox x:Name="VerifyStreamsCheck" IsChecked="True" Margin="0,16,0,0" Foreground="{StaticResource TextBrush}">
                                        <TextBlock Text="Verify NTFS/ReFS named data streams"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>


                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Advanced protection" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Optional consistency, manifest, and conflict-review features." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,14"/>

                                    <CheckBox x:Name="VssSnapshotCheck" Foreground="{StaticResource TextBrush}" Checked="AdvancedOption_Changed" Unchecked="AdvancedOption_Changed">
                                        <StackPanel>
                                            <TextBlock Text="Use VSS point-in-time snapshot"/>
                                            <TextBlock Text="Reads from a stable snapshot of the source volume. Requires Administrator; unavailable for Retry Failed." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox x:Name="AutoManifestCheck" Margin="0,14,0,0" Foreground="{StaticResource TextBrush}" Checked="AdvancedOption_Changed" Unchecked="AdvancedOption_Changed">
                                        <StackPanel>
                                            <TextBlock Text="Create SHA-256 integrity manifest after successful copy + verification"/>
                                            <TextBlock Text="Optional extra pass over the destination. The manifest can later prove backup contents without the original source." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="ManifestStreamsCheck" IsChecked="True" IsEnabled="False" Margin="24,8,0,0" Foreground="{StaticResource TextBrush}">
                                        <TextBlock Text="Include NTFS/ReFS named data streams in manifest"/>
                                    </CheckBox>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button x:Name="ReviewConflictsButton" Content="Review conflicts" Style="{StaticResource SecondaryButton}" Click="ReviewConflicts_Click"/>
                                        <CheckBox x:Name="ConflictDeepScanCheck" Grid.Column="2" Content="Deep exact scan (hash same-size/same-time pairs too)" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>


                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="After successful run" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Optional action after Copy + Verify and all requested post-verification work completes." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="ACTION" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                            <ComboBox x:Name="PostRunActionBox" SelectedIndex="0" Height="36" Margin="0,6,0,0" Background="#0D1524" Foreground="White" BorderBrush="{StaticResource BorderBrush}" SelectionChanged="PostRunAction_Changed">
                                                <ComboBoxItem Content="Do nothing" Tag="None"/>
                                                <ComboBoxItem Content="Safely eject destination" Tag="EjectDestination"/>
                                                <ComboBoxItem Content="Shutdown Windows" Tag="Shutdown"/>
                                                <ComboBoxItem Content="Eject destination, then shutdown" Tag="EjectThenShutdown"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="SHUTDOWN DELAY" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                            <ComboBox x:Name="ShutdownDelayBox" SelectedIndex="1" Height="36" Margin="0,6,0,0" Background="#0D1524" Foreground="White" BorderBrush="{StaticResource BorderBrush}">
                                                <ComboBoxItem Content="30 sec" Tag="30"/><ComboBoxItem Content="60 sec" Tag="60"/><ComboBoxItem Content="120 sec" Tag="120"/><ComboBoxItem Content="5 min" Tag="300"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="PostRunHint" Text="Runs only after a successful Copy + Verify. Eject uses Windows Explorer's own Eject action; shutdown can still be cancelled with shutdown /a." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#101B2A" BorderBrush="#23415E" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Safety policy" FontSize="15" FontWeight="SemiBold"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="✓ Destination-only data is kept" Foreground="#86EFAC" Margin="0,0,0,7"/>
                                            <TextBlock Text="✓ Source files are never deleted" Foreground="#86EFAC"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="✓ Source wins exact-path conflicts" Foreground="#86EFAC" Margin="0,0,0,7"/>
                                            <TextBlock Text="✓ No mirror / purge / move" Foreground="#86EFAC"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Run status" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="24" FontWeight="SemiBold" Margin="0,14,0,2"/>
                                    <TextBlock x:Name="StatusDetail" Text="Configure the migration and start when ready." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/>
                                    <ProgressBar x:Name="RunProgress" Height="5" Margin="0,16,0,16" IsIndeterminate="False" Value="0" Background="#243047" Foreground="{StaticResource AccentBrush}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border x:Name="CopyPhase" Background="#0D1524" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                            <StackPanel><TextBlock Text="1  COPY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="CopyPhaseState" Text="Waiting" Margin="0,5,0,0"/></StackPanel>
                                        </Border>
                                        <Border x:Name="VerifyPhase" Grid.Column="2" Background="#0D1524" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                            <StackPanel><TextBlock Text="2  VERIFY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="VerifyPhaseState" Text="Waiting" Margin="0,5,0,0"/></StackPanel>
                                        </Border>
                                        <Border x:Name="AuditPhase" Grid.Column="4" Background="#0D1524" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                            <StackPanel><TextBlock Text="3  AUDIT" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="AuditPhaseState" Text="Waiting" Margin="0,5,0,0"/></StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Files checked" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                            <TextBlock x:Name="FilesCheckedText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Data verified" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                            <TextBlock x:Name="DataVerifiedText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14"/>
                                    <TextBlock Text="Performance dashboard" FontSize="13" FontWeight="SemiBold"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel><TextBlock Text="Total I/O" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="IoTotalSpeedText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Read" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="IoReadSpeedText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Write" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="IoWriteSpeedText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="Elapsed" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="ElapsedRunText" Text="00:00:00" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"><TextBlock Text="Average I/O" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="ActiveProcessesText" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0"><TextBlock Text="Copy limit" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="IoLimitText" Text="Unlimited" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                    </Grid>
                                    <TextBlock Text="I/O telemetry is process-level and approximate; it includes SafeCopy/Robocopy file I/O." Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Live log" FontSize="15" FontWeight="SemiBold"/>
                                        <Button Grid.Column="1" Content="Open logs" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11" Click="OpenLogs_Click"/>
                                    </Grid>
                                    <TextBox x:Name="LogBox" Margin="0,12,0,0" Height="250" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="StartButton" Grid.Column="0" Content="Start copy + verify" Style="{StaticResource PrimaryButton}" Height="46" Click="Start_Click"/>
                                <Button x:Name="PauseButton" Grid.Column="2" Content="Pause" Style="{StaticResource SecondaryButton}" Height="46" MinWidth="90" IsEnabled="False" Click="PauseMigration_Click"/>
                                <Button x:Name="CancelButton" Grid.Column="4" Content="Cancel" Style="{StaticResource DangerButton}" Height="46" IsEnabled="False" Click="Cancel_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>


            <TabItem Header="Integrity">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="8,14,8,24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Backup Integrity Manifest" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Generate a streamed SHA-256 manifest for a directory, or verify a backup later without needing the original source." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap"/>

                                    <TextBlock Text="DIRECTORY TO RECORD / VERIFY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="IntegrityRootBox" MinHeight="38" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseIntegrityRoot_Click"/>
                                    </Grid>

                                    <TextBlock Text="MANIFEST FILE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="IntegrityManifestBox" MinHeight="38" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Open" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseManifestOpen_Click"/>
                                        <Button Grid.Column="2" Content="Save as" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseManifestSave_Click"/>
                                    </Grid>

                                    <CheckBox x:Name="IntegrityStreamsCheck" IsChecked="True" Margin="0,16,0,0" Foreground="{StaticResource TextBrush}">
                                        <TextBlock Text="Include named NTFS/ReFS streams when generating"/>
                                    </CheckBox>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Button x:Name="GenerateManifestButton" Content="Generate manifest" Style="{StaticResource PrimaryButton}" Height="42" Click="GenerateManifest_Click"/>
                                        <Button x:Name="VerifyManifestButton" Grid.Column="2" Content="Verify manifest" Style="{StaticResource SecondaryButton}" Height="42" Click="VerifyManifest_Click"/>
                                        <Button x:Name="CancelManifestButton" Grid.Column="4" Content="Cancel" Style="{StaticResource DangerButton}" Height="42" IsEnabled="False" Click="CancelManifest_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#101B2A" BorderBrush="#23415E" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Manifest scope" FontWeight="SemiBold"/>
                                    <TextBlock Text="The manifest records file content (SHA-256), size, relative path, and optionally named data streams. Destination-only extra files are allowed and do not invalidate a manifest verification." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                                    <TextBlock Text="ACLs, ownership, SACLs, hard-link topology, and filesystem allocation details are not part of manifest identity." Foreground="#FBBF24" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Integrity status" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="IntegrityStatusText" Text="Ready" FontSize="23" FontWeight="SemiBold" Margin="0,14,0,2"/>
                                    <TextBlock x:Name="IntegrityStatusDetail" Text="Choose a directory and manifest action." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/>
                                    <ProgressBar x:Name="IntegrityProgress" Height="5" Margin="0,16,0,16" Background="#243047" Foreground="{StaticResource AccentBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Files" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="IntegrityFilesText" Text="0" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Streams" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="IntegrityStreamsText" Text="0" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Data" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="IntegrityBytesText" Text="0 B" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Verification issues" FontSize="15" FontWeight="SemiBold"/>
                                        <Button Grid.Column="1" Content="Open manifests folder" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11" Click="OpenManifests_Click"/>
                                    </Grid>
                                    <TextBox x:Name="IntegrityIssuesBox" Margin="0,12,0,0" Height="310" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Storage Analyzer">
                <Grid Margin="8,14,8,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
