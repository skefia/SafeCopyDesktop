                            </Grid>
                        </TabItem>

                        <TabItem Header="Cleanup Suggestions">
                            <Grid Margin="6,12,6,6">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Conservative cleanup review" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Suggestions are explainable candidates only. SafeCopy never auto-deletes them and excludes protected/system locations." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Maximum suggestions" Foreground="{StaticResource MutedBrush}" FontSize="10"/><ComboBox x:Name="CleanupTopBox" SelectedIndex="3" Margin="0,6,0,0" Height="38" Background="#0D1524" Foreground="White" BorderBrush="{StaticResource BorderBrush}"><ComboBoxItem Content="500"/><ComboBoxItem Content="1000"/><ComboBoxItem Content="2500"/><ComboBoxItem Content="5000"/><ComboBoxItem Content="10000"/></ComboBox></StackPanel><Button x:Name="CleanupScanButton" Grid.Column="3" Content="Analyze insights" Style="{StaticResource PrimaryButton}" Height="38" VerticalAlignment="Bottom" Click="InsightsScan_Click"/></Grid>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CleanupStatusText" Text="Ready" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CleanupStatusDetail" Text="No cleanup action is automatic." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Candidates" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="CleanupCountText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Potential space" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="CleanupBytesText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="6"><TextBlock Text="Selected" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="CleanupSelectedText" Text="0 files / 0 B" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid></Border>
                                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,14"><DataGrid x:Name="CleanupGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" AlternationCount="2" SelectionChanged="CleanupGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="90"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/><DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" SortMemberPath="SizeBytes" Width="110"/><DataGridTextColumn Header="Age" Binding="{Binding AgeDisplay}" SortMemberPath="AgeDays" Width="105"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*"/><DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="3*"/></DataGrid.Columns></DataGrid></Border>
                                <Border Grid.Row="3" Style="{StaticResource CardBorder}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="CleanupOpenButton" Content="Open location" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="CleanupOpen_Click"/><Button x:Name="CleanupCopyButton" Grid.Column="2" Content="Copy path(s)" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="CleanupCopy_Click"/><Button x:Name="CleanupMoveButton" Grid.Column="4" Content="Move…" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="CleanupMove_Click"/><Button x:Name="CleanupZipButton" Grid.Column="6" Content="ZIP…" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="CleanupZip_Click"/><Button x:Name="CleanupRecycleButton" Grid.Column="8" Content="Delete (Recycle Bin)" Style="{StaticResource DangerButton}" IsEnabled="False" Click="CleanupRecycle_Click"/><Button x:Name="CleanupExportButton" Grid.Column="10" Content="Export CSV" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="CleanupExport_Click"/><TextBlock Grid.Column="11" Text="Review every selection. Suggestions are not proof that a file is disposable." Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>


            <TabItem Header="Disk Map &amp; Index">
                <Grid Margin="8,14,8,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Visual Disk Usage Map + Incremental Scan Database" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Build a persistent SQLite metadata index, then explore cached disk usage without rescanning the drive every time." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="DiskMapRootBox" Height="38" VerticalContentAlignment="Center"/>
