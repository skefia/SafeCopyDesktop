                                <Button x:Name="IndexScanButton" Grid.Column="3" Content="Incremental scan" Style="{StaticResource PrimaryButton}" Click="IndexScan_Click"/>
                                <Button x:Name="IndexFullButton" Grid.Column="5" Content="Full refresh" Style="{StaticResource SecondaryButton}" Click="IndexFull_Click"/>
                                <Button x:Name="IndexLoadButton" Grid.Column="7" Content="Load cached" Style="{StaticResource SecondaryButton}" Click="IndexLoad_Click"/>
                                <Button x:Name="IndexPauseButton" Grid.Column="9" Content="Pause" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="IndexPause_Click"/>
                            </Grid>
                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="IndexStatusDetail" Text="No index loaded." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                                <Button x:Name="IndexCancelButton" Grid.Column="1" Content="Cancel scan" Style="{StaticResource DangerButton}" IsEnabled="False" Click="IndexCancel_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock x:Name="IndexStatusText" Text="Ready" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DiskMapBreadcrumbText" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Files" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="IndexFilesText" Text="—" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Indexed size" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="IndexBytesText" Text="—" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="Changed / added" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="IndexChangedText" Text="—" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Metadata reused" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="IndexReusedText" Text="—" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="12,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="DiskMapBackButton" Content="← Back" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="DiskMapBack_Click"/>
                                <TextBlock Grid.Column="2" Text="Rectangle area is proportional to logical size. Double-click a folder below or click a rectangle to drill in." Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Cached index: %LOCALAPPDATA%\SafeCopy\Desktop" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center"/>
                            </Grid>
                            <Canvas x:Name="DiskMapCanvas" Grid.Row="1" Background="#09111D" SizeChanged="DiskMapCanvas_SizeChanged"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
                        <DataGrid x:Name="DiskMapGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="DiskMapGrid_DoubleClick">
                            <DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="90"/><DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="120"/><DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="100"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="3*"/></DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Archive Manager">
                <Grid Margin="8,14,8,24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Create verified ZIP archive" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Archives are built to a temporary file and every file entry is SHA-256 verified before the requested ZIP replaces an existing archive." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,14" TextWrapping="Wrap"/>
                                <WrapPanel><Button Content="Add files…" Style="{StaticResource SecondaryButton}" Click="ArchiveAddFiles_Click"/><Button Content="Add folder…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ArchiveAddFolder_Click"/><Button Content="Remove selected" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ArchiveRemove_Click"/><Button Content="Clear" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ArchiveClear_Click"/></WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,14"><DataGrid x:Name="ArchiveSourceGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding KindDisplay}" Width="90"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="Source path" Binding="{Binding FullPath}" Width="*"/></DataGrid.Columns></DataGrid></Border>
                        <Border Grid.Row="2" Style="{StaticResource CardBorder}"><StackPanel>
                            <TextBlock Text="OUTPUT ZIP" Foreground="{StaticResource MutedBrush}" FontSize="10"/><Grid Margin="0,6,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ArchiveDestinationBox" Height="38" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ArchiveDestinationBrowse_Click"/></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Compression" Foreground="{StaticResource MutedBrush}" FontSize="10"/><ComboBox x:Name="ArchiveCompressionBox" SelectedIndex="2" Height="36" Margin="0,6,0,0" Background="#0D1524" Foreground="White" BorderBrush="{StaticResource BorderBrush}"><ComboBoxItem Content="No compression" Tag="NoCompression"/><ComboBoxItem Content="Fastest" Tag="Fastest"/><ComboBoxItem Content="Optimal" Tag="Optimal"/><ComboBoxItem Content="Smallest size" Tag="SmallestSize"/></ComboBox></StackPanel><CheckBox x:Name="ArchiveRecycleCheck" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,8" Foreground="{StaticResource TextBrush}"><TextBlock Text="After archive verification, ask whether to send original selections to Recycle Bin" TextWrapping="Wrap"/></CheckBox></Grid>
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="ArchiveCreateButton" Content="Create + verify archive" Style="{StaticResource PrimaryButton}" Click="ArchiveCreate_Click"/><Button x:Name="ArchivePauseButton" Grid.Column="1" Content="Pause" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="ArchivePause_Click"/><Button x:Name="ArchiveCancelButton" Grid.Column="3" Content="Cancel" Style="{StaticResource DangerButton}" IsEnabled="False" Click="ArchiveCancel_Click"/></Grid>
                        </StackPanel></Border>
                    </Grid>
                    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Archive status" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ArchiveStatusText" Text="Ready" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="ArchiveStatusDetail" Text="Add sources or inspect an existing ZIP." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/><ProgressBar x:Name="ArchiveProgress" Height="5" Margin="0,14,0,0"/></StackPanel></Border>
                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Open / test / extract ZIP" FontSize="16" FontWeight="SemiBold"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ArchiveOpenBox" Height="38" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ArchiveOpenBrowse_Click"/></Grid><WrapPanel Margin="0,12,0,0"><Button Content="Load contents" Style="{StaticResource SecondaryButton}" Click="ArchiveLoad_Click"/><Button Content="Test archive" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ArchiveTest_Click"/><Button Content="Extract…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ArchiveExtract_Click"/><CheckBox x:Name="ArchiveExtractOverwriteCheck" Content="Allow overwrite during extraction" Foreground="{StaticResource TextBrush}" Margin="14,6,0,0"/></WrapPanel></StackPanel></Border>
                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0"><DataGrid x:Name="ArchiveEntriesGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Entry" Binding="{Binding EntryName}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="110"/><DataGridTextColumn Header="Compressed" Binding="{Binding CompressedDisplay}" Width="110"/><DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="160"/></DataGrid.Columns></DataGrid></Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostics">
                <Grid Margin="8,14,8,24">
                    <TabControl>
                        <TabItem Header="Problem Files">
                            <Grid Margin="6,12,6,6">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Directory to inspect" FontSize="16" FontWeight="SemiBold"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ProblemRootBox" Height="38" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseProblemRoot_Click"/></Grid></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Scan mode" Foreground="{StaticResource MutedBrush}" FontSize="10"/><ComboBox x:Name="ProblemModeBox" SelectedIndex="1" Margin="0,8,0,0" Height="38" Background="#0D1524" Foreground="White" BorderBrush="{StaticResource BorderBrush}"><ComboBoxItem Content="Fast metadata" Tag="Fast"/><ComboBoxItem Content="Deep readability test" Tag="Deep"/></ComboBox></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="Max results" Foreground="{StaticResource MutedBrush}" FontSize="10"/><ComboBox x:Name="ProblemMaxBox" SelectedIndex="2" Margin="0,8,0,0" Height="38" Background="#0D1524" Foreground="White" BorderBrush="{StaticResource BorderBrush}"><ComboBoxItem Content="1000"/><ComboBoxItem Content="2500"/><ComboBoxItem Content="5000"/><ComboBoxItem Content="10000"/><ComboBoxItem Content="25000"/></ComboBox></StackPanel>
                                        <Button x:Name="ProblemScanButton" Grid.Column="6" Content="Scan" Style="{StaticResource PrimaryButton}" Height="38" VerticalAlignment="Bottom" Click="ProblemScan_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ProblemStatusText" Text="Ready" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ProblemStatusDetail" Text="Read-only diagnostics; reparse points are never traversed." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Files" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="ProblemFilesText" Text="—" FontSize="16" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Problems" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="ProblemCountText" Text="—" FontSize="16" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Locked" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="ProblemLockedText" Text="—" FontSize="16" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Read errors" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="ProblemReadErrorText" Text="—" FontSize="16" FontWeight="SemiBold"/></StackPanel></Grid></Border>
                                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,14"><DataGrid x:Name="ProblemGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/><DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="110"/><DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDisplay}" Width="150"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*"/><DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="3*"/></DataGrid.Columns></DataGrid></Border>
                                <Border Grid.Row="3" Style="{StaticResource CardBorder}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Open location" Style="{StaticResource SecondaryButton}" Click="ProblemOpen_Click"/><Button Grid.Column="2" Content="Copy path(s)" Style="{StaticResource SecondaryButton}" Click="ProblemCopy_Click"/><Button x:Name="ProblemPauseButton" Grid.Column="4" Content="Pause" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="ProblemPause_Click"/><Button x:Name="ProblemCancelButton" Grid.Column="6" Content="Cancel" Style="{StaticResource DangerButton}" IsEnabled="False" Click="ProblemCancel_Click"/><Button Grid.Column="7" Content="Export CSV" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="ProblemExport_Click"/></Grid></Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Compare Two Folders">
                            <Grid Margin="6,12,6,6">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="LEFT DIRECTORY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CompareLeftBox" Height="38" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseCompareLeft_Click"/></Grid></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="RIGHT DIRECTORY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CompareRightBox" Height="38" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseCompareRight_Click"/></Grid></StackPanel>
                                        <Grid Grid.ColumnSpan="3" Margin="0,70,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="14"/><ColumnDefinition Width="160"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Comparison mode" Foreground="{StaticResource MutedBrush}" FontSize="10"/><ComboBox x:Name="CompareModeBox" SelectedIndex="0" Margin="0,6,0,0" Height="36" Background="#0D1524" Foreground="White" BorderBrush="{StaticResource BorderBrush}"><ComboBoxItem Content="Quick metadata" Tag="Quick"/><ComboBoxItem Content="Exact byte-for-byte" Tag="Exact"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Max differences shown" Foreground="{StaticResource MutedBrush}" FontSize="10"/><ComboBox x:Name="CompareMaxBox" SelectedIndex="3" Margin="0,6,0,0" Height="36" Background="#0D1524" Foreground="White" BorderBrush="{StaticResource BorderBrush}"><ComboBoxItem Content="1000"/><ComboBoxItem Content="2500"/><ComboBoxItem Content="5000"/><ComboBoxItem Content="10000"/><ComboBoxItem Content="25000"/></ComboBox></StackPanel><Button x:Name="CompareStartButton" Grid.Column="4" Content="Compare folders" Style="{StaticResource PrimaryButton}" Height="36" VerticalAlignment="Bottom" Click="CompareStart_Click"/></Grid>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CompareStatusText" Text="Ready" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CompareStatusDetail" Text="Quick mode uses path/size/timestamp; Exact mode reads file contents." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Same" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="CompareSameText" Text="—" FontSize="16" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Left only" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="CompareLeftOnlyText" Text="—" FontSize="16" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Right only" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="CompareRightOnlyText" Text="—" FontSize="16" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Different" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="CompareDifferentText" Text="—" FontSize="16" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="5"><TextBlock Text="Errors" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="CompareErrorText" Text="—" FontSize="16" FontWeight="SemiBold"/></StackPanel></Grid></Border>
                                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,14"><DataGrid x:Name="CompareGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="Relative path" Binding="{Binding RelativePath}" Width="2*"/><DataGridTextColumn Header="Left size" Binding="{Binding LeftSizeDisplay}" Width="110"/><DataGridTextColumn Header="Right size" Binding="{Binding RightSizeDisplay}" Width="110"/><DataGridTextColumn Header="Left modified" Binding="{Binding LeftModifiedDisplay}" Width="150"/><DataGridTextColumn Header="Right modified" Binding="{Binding RightModifiedDisplay}" Width="150"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*"/></DataGrid.Columns></DataGrid></Border>
                                <Border Grid.Row="3" Style="{StaticResource CardBorder}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Open left" Style="{StaticResource SecondaryButton}" Click="CompareOpenLeft_Click"/><Button Grid.Column="2" Content="Open right" Style="{StaticResource SecondaryButton}" Click="CompareOpenRight_Click"/><Button Grid.Column="4" Content="Copy relative path" Style="{StaticResource SecondaryButton}" Click="CompareCopyPath_Click"/><Button x:Name="ComparePauseButton" Grid.Column="6" Content="Pause" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="ComparePause_Click"/><Button x:Name="CompareCancelButton" Grid.Column="8" Content="Cancel" Style="{StaticResource DangerButton}" IsEnabled="False" Click="CompareCancel_Click"/><Button Grid.Column="9" Content="Export CSV" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="CompareExport_Click"/></Grid></Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#0E1627" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="26,10">
            <Grid>
                <TextBlock Text="Migration is non-destructive. Analyzer scans are read-only; file actions require explicit selection and confirmation." Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                <TextBlock x:Name="RuntimeText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</Window>
