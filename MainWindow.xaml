                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TypeStatusText" Text="Ready" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="TypeStatusDetail" Text="Aggregate logical storage by file extension using the same one-pass insights scan." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><Button x:Name="TypeScanButton" Grid.Column="1" Content="Analyze insights" Style="{StaticResource PrimaryButton}" Height="38" Click="InsightsScan_Click"/></Grid>
