<Window x:Class="SafeCopy.Desktop.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Conflict Viewer" Height="720" Width="1180" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Smart Conflict Viewer" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Read-only preview of exact relative paths that differ between source and destination." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="PairText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="DeepCheck" Content="Deep exact scan" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" Margin="0,0,14,0"/>
                    <Button x:Name="ScanButton" Content="Scan conflicts" Style="{StaticResource PrimaryButton}" Click="Scan_Click"/>
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource DangerButton}" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Conflicts" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="ConflictCountText" Text="0" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Pairs compared" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="PairsText" Text="0" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="Errors" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="ErrorsText" Text="0" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="5" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="StatusDetail" Text="Quick mode hashes only same-size pairs whose timestamps differ. Deep mode hashes all same-size pairs." Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="520"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="ConflictGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Relative path" Binding="{Binding RelativePath}" Width="2.3*"/>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="1.3*"/>
                <DataGridTextColumn Header="Source size" Binding="{Binding SourceSize}" Width="110"/>
                <DataGridTextColumn Header="Destination size" Binding="{Binding DestinationSize}" Width="120"/>
                <DataGridTextColumn Header="Source modified" Binding="{Binding SourceModified}" Width="145"/>
                <DataGridTextColumn Header="Destination modified" Binding="{Binding DestinationModified}" Width="145"/>
                <DataGridTextColumn Header="Policy" Binding="{Binding Decision}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="Open source" Style="{StaticResource SecondaryButton}" Click="OpenSource_Click"/>
            <Button Grid.Column="2" Content="Open destination" Style="{StaticResource SecondaryButton}" Click="OpenDestination_Click"/>
            <Button Grid.Column="4" Content="Export CSV" Style="{StaticResource SecondaryButton}" Click="Export_Click"/>
            <Button Grid.Column="6" Content="Close" Style="{StaticResource PrimaryButton}" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
